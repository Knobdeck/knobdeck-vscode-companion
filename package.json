{
  "name": "knobdeck-vscode-companion",
  "displayName": "KnobDeck VS Code Companion",
  "description": "Lets the KnobDeck dial and deck control VS Code: run tasks, start debugging, switch editors and terminals, and run any command.",
  "version": "1.1.0",
  "publisher": "knobdeck",
  "author": "Harshal Kudale",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#12161A",
    "theme": "dark"
  },
  "homepage": "https://knobdeck.harshalkudale.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Knobdeck/knobdeck-vscode-companion.git"
  },
  "bugs": {
    "url": "https://github.com/Knobdeck/knobdeck-vscode-companion/issues"
  },
  "keywords": [
    "knobdeck",
    "stream deck",
    "macro pad",
    "dial",
    "shortcuts"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "knobdeck.startServer",
        "title": "Link This Window to KnobDeck",
        "category": "KnobDeck"
      },
      {
        "command": "knobdeck.stopServer",
        "title": "Unlink This Window from KnobDeck",
        "category": "KnobDeck"
      },
      {
        "command": "knobdeck.showStatus",
        "title": "Show Connection Status",
        "category": "KnobDeck"
      },
      {
        "command": "knobdeck.browseCommands",
        "title": "Copy a Command ID",
        "category": "KnobDeck"
      }
    ],
    "configuration": {
      "title": "KnobDeck VS Code Companion",
      "properties": {
        "knobdeck.port": {
          "type": "integer",
          "default": 32145,
          "minimum": 1,
          "maximum": 65535,
          "scope": "application",
          "order": 0,
          "markdownDescription": "Port of the action server for **older KnobDeck versions** (on `127.0.0.1` only; see *Legacy Server*). Current KnobDeck links through its companion hub and needs no port."
        },
        "knobdeck.password": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 1,
          "markdownDescription": "Optional password for the action server for **older KnobDeck versions**. Current KnobDeck links through its companion hub, which needs no password."
        },
        "knobdeck.autostart": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 2,
          "description": "Link to KnobDeck when VS Code starts."
        },
        "knobdeck.legacyServer": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 3,
          "markdownDescription": "Also run the local HTTP action server for KnobDeck versions without the companion hub. Turn it off once KnobDeck is up to date."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "node test/e2e/run.js",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "ovsx": "1.4.0"
  },
  "dependencies": {
    "@knobdeck/companion": "0.2.0",
    "ws": "8.22.1"
  }
}
